APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Huisstijl mails (De Gouden + cursief accent) en factuurafzender (briefing 29 okt §2)
MAIL_BRAND_NAME="De Gouden"
MAIL_BRAND_ACCENT=Bol
MAIL_BRAND_TEAM="Team De Gouden Bol"
INVOICE_ISSUER_LEGAL_NAME="Nederlands Test Instituut"
INVOICE_ISSUER_ADDRESS="Voorstraat 14, 6702 DC Wageningen"
INVOICE_ISSUER_KVK=42193967
# Btw-nummer pas invullen als het juiste nummer is bevestigd
# INVOICE_ISSUER_VAT=
# INVOICE_ISSUER_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# De Gouden Bol
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Europe/Amsterdam
STYLEGUIDE_ENABLED=true
# Google Tag Manager op de publiekssite (alleen in productie)
GTM_ID=GTM-TV5Z4R84
SITE_PLACEHOLDERS=false

DB_TESTING_DATABASE=degoudenbol_testing
DB_TESTING_USERNAME=dgb_testing
DB_TESTING_PASSWORD=

DB_VAULT_DATABASE=degoudenbol_vault
DB_VAULT_USERNAME=dgb_vault
DB_VAULT_PASSWORD=
VAULT_ENCRYPTION_KEY=
AUDIT_HASH_SALT=

# Betalingen: stripe (productie), fake (lokaal). Sleutels uit het Stripe-dashboard > Ontwikkelaars.
PAYMENT_DRIVER=stripe
RESERVATION_MINUTES=60
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Paginacache publiekssite en CDN-purge (config/publiccache.php)
PUBLIC_CACHE_ENABLED=true
PUBLIC_CACHE_TTL=10
CDN_DRIVER=null
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare Turnstile op het aanmeldformulier (leeg = uit)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Mail via Mailgun (API); EU-domein: MAILGUN_ENDPOINT=api.eu.mailgun.net
# MAIL_MAILER=mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net

# Blogs en landingspagina's van de contentmachine (leestoken van de site in EazyDash)
EAZY_CMS_URL=https://eazyonline.nl/api/v1
EAZY_CMS_TOKEN=
